{
  "name": "relayctx",
  "private": true,
  "version": "0.1.0",
  "description": "Keep your AI sessions moving — a Chrome extension that safely continues watched Claude tabs past output and usage limits.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^7.3.6"
  }
}
